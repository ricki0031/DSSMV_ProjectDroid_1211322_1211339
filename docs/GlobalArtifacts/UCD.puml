@startuml
'https://plantuml.com/use-case-diagram
left to right direction
title Use Case Diagram

actor "User" as User

rectangle "SpotifyClone" {
    usecase "Log In with Spotify" as UC1
    usecase "View Home" as UC2
    usecase "Search Content" as UC3
    usecase "View Library" as UC4
    usecase "Create Playlist" as UC5
    usecase "View Playlist" as UC6
    usecase "Edit Playlist" as UC7
    usecase "Add Track to Playlist" as UC8
    usecase "Remove Track from Playlist" as UC9
    usecase "Manage Favourite Songs" as UC10
    usecase "View Album" as UC11
    usecase "View Artist" as UC12
    usecase "Play Music" as UC13
    usecase "Control Playback" as UC14
    usecase "Manage Queue" as UC15
}

User -- UC1
