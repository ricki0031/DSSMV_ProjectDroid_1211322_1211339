<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Cabeçalho -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

        <TextView
                android:id="@+id/textSearchTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pesquisar"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Descobre a tua próxima música favorita."
                android:textColor="#C4D8D0"
                android:textSize="14sp" />

        <!-- Barra de pesquisa -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:elevation="3dp">

            <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:contentDescription="Pesquisar"
                    app:tint="#626262" />

            <EditText
                    android:id="@+id/editSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="Músicas, artistas, álbuns..."
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:textColor="#121212"
                    android:textColorHint="#777777"
                    android:textSize="16sp"
                    android:padding="0dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Explorar géneros musicais -->
    <LinearLayout
            android:id="@+id/layoutExploreGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explorar música"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

        <!-- Primeira linha -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

            <TextView
                    android:id="@+id/genrePop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_genre_pop"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:text="🎤  Pop"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            <TextView
                    android:id="@+id/genreHipHop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_genre_hiphop"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:text="🎧  Hip-Hop"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
        </LinearLayout>

        <!-- Segunda linha -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

            <TextView
                    android:id="@+id/genreRock"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_genre_rock"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:text="🎸  Rock"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            <TextView
                    android:id="@+id/genreElectronic"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_genre_electronic"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:text="🎛️  Eletrónica"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
        </LinearLayout>

        <!-- Terceira linha -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/genreRelax"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_genre_relax"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:text="🌙  Relaxar"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            <TextView
                    android:id="@+id/genreDiscover"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_genre_discover"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:text="✨  Descobrir"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- Resultados de músicas -->
    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Músicas"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSearchTracks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false" />

    <!-- Resultados de artistas, álbuns e playlists -->
    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="Artistas, álbuns e playlists"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSearchMedia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false" />

    <!-- Mensagem sem resultados -->
    <TextView
            android:id="@+id/textSearchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:text="Nenhum resultado encontrado"
            android:textColor="#B3B3B3"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone" />

</LinearLayout>
